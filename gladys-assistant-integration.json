    {
      "key": "get_mower_status",
      "label": {
        "en": "Read a mower",
        "fr": "Lire une tondeuse"
      },
      "description": {
        "en": "Hands the state of the mower to the next steps of the scene.",
        "fr": "Passe l'état de la tondeuse aux étapes suivantes de la scène."
      },
      "timeout_seconds": 45,
      "fields": [
        {
          "key": "mower",
