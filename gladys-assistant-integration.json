{
  "manifest_version": 1,
  "type": "device",
  "name": "Mammotion",
  "description": {
    "en": "Control your Mammotion mower (Luba, Yuka): mowing, pause, return to dock, battery and status.",
    "fr": "Pilotez votre tondeuse Mammotion (Luba, Yuka) : tonte, pause, retour à la base, batterie, état."
  },
  "version": "1.2.0",
  "docker_image": "ghcr.io/prohand/gladys-mammotion:1.2.0",
  "gladys_version": ">=4.86.0",
  "cover_image": "https://raw.githubusercontent.com/prohand/gladys-mammotion/main/cover.png",
  "categories": [
    "appliances"
  ],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Mammotion account",
        "fr": "Compte Mammotion"
      },
      "description": {
        "en": "Use the email and password of your Mammotion app account. Tip: create a second account, share the mower with it from the app, and use it here, so Gladys does not log you out of your phone.",
        "fr": "Utilisez l'email et le mot de passe de votre compte de l'application Mammotion. Astuce : créez un second compte, partagez-lui la tondeuse depuis l'application et utilisez-le ici, pour que Gladys ne vous déconnecte pas de votre téléphone."
      },
      "links": [
        {
          "url": "https://mammotion.com",
          "label": {
            "en": "Mammotion website",
            "fr": "Site Mammotion"
          }
        }
      ]
    },
    {
      "key": "email",
      "type": "string",
      "label": {
        "en": "Email",
        "fr": "Email"
      },
      "required": true
    },
    {
      "key": "password",
      "type": "secret",
      "label": {
        "en": "Password",
        "fr": "Mot de passe"
      },
      "required": true
    },
    {
      "key": "poll_frequency",
      "type": "number",
      "label": {
        "en": "Refresh interval (s)",
        "fr": "Intervalle de rafraîchissement (s)"
      },
      "description": {
        "en": "How often each mower is read, in seconds. Each read asks the mower for its state, which can briefly disturb the Mammotion app: 300 s or more is advised.",
        "fr": "Fréquence de lecture de chaque tondeuse, en secondes. Chaque lecture demande son état à la tondeuse, ce qui peut gêner un instant l'appli Mammotion : 300 s ou plus conseillé."
      },
      "required": false,
      "default": 300,
      "min": 30,
      "max": 3600
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Status language",
        "fr": "Langue de l'état"
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français"
          }
        },
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais"
          }
        }
      ]
    },
    {
      "key": "mowing",
      "type": "section",
      "label": {
        "en": "New mowing job",
        "fr": "Nouvelle tonte"
      },
      "description": {
        "en": "Settings of a new job started from Gladys (Mowing switch ON, mower docked or ready). Each mower also shows them as \"Zone to mow – …\" switches and \"Setting – …\" lists, to change them for that mower only, from the dashboard or a scene. Saving a new value here applies it to every mower. The Mammotion app keeps its own settings on the phone: Gladys cannot read them.",
        "fr": "Réglages d'une nouvelle tonte lancée par Gladys (interrupteur Tonte sur ON, tondeuse à la base ou prête). Chaque tondeuse les affiche aussi en interrupteurs « Zone à tondre – … » et en listes « Réglage – … », pour les changer pour elle seule, depuis le tableau de bord ou une scène. Enregistrer ici une nouvelle valeur l'applique à toutes les tondeuses. L'application Mammotion garde ses réglages dans le téléphone : Gladys ne peut pas les lire."
      }
    },
    {
      "key": "mowing_zones",
      "type": "string",
      "label": {
        "en": "Zones to mow",
        "fr": "Zones à tondre"
      },
      "description": {
        "en": "Zone names as shown in the app, separated by commas. Empty: every zone of the map. Each mower also shows one \"Zone to mow – …\" switch per zone of its map.",
        "fr": "Noms des zones comme dans l'application, séparés par des virgules. Vide : toutes les zones de la carte. Chaque tondeuse affiche aussi un interrupteur « Zone à tondre – … » par zone de sa carte."
      },
      "required": false,
      "default": ""
    },
    {
      "key": "blade_height",
      "type": "number",
      "label": {
        "en": "Blade height (mm)",
        "fr": "Hauteur de coupe (mm)"
      },
      "description": {
        "en": "Kept within the range of each mower model (e.g. 25 to 70 mm on a Luba 2).",
        "fr": "Ramenée dans la plage de chaque modèle de tondeuse (par ex. 25 à 70 mm sur une Luba 2)."
      },
      "required": false,
      "default": 60,
      "min": 15,
      "max": 100
    },
    {
      "key": "mowing_speed",
      "type": "select",
      "label": {
        "en": "Speed (m/s)",
        "fr": "Vitesse (m/s)"
      },
      "required": false,
      "default": "0.6",
      "options": [
        {
          "value": "0.2",
          "label": {
            "en": "0.2 m/s",
            "fr": "0,2 m/s"
          }
        },
        {
          "value": "0.3",
          "label": {
            "en": "0.3 m/s",
            "fr": "0,3 m/s"
          }
        },
        {
          "value": "0.4",
          "label": {
            "en": "0.4 m/s",
            "fr": "0,4 m/s"
          }
        },
        {
          "value": "0.5",
          "label": {
            "en": "0.5 m/s",
            "fr": "0,5 m/s"
          }
        },
        {
          "value": "0.6",
          "label": {
            "en": "0.6 m/s",
            "fr": "0,6 m/s"
          }
        },
        {
          "value": "0.7",
          "label": {
            "en": "0.7 m/s",
            "fr": "0,7 m/s"
          }
        },
        {
          "value": "0.8",
          "label": {
            "en": "0.8 m/s",
            "fr": "0,8 m/s"
          }
        },
        {
          "value": "0.9",
          "label": {
            "en": "0.9 m/s",
            "fr": "0,9 m/s"
          }
        },
        {
          "value": "1.0",
          "label": {
            "en": "1.0 m/s",
            "fr": "1,0 m/s"
          }
        },
        {
          "value": "1.1",
          "label": {
            "en": "1.1 m/s",
            "fr": "1,1 m/s"
          }
        },
        {
          "value": "1.2",
          "label": {
            "en": "1.2 m/s",
            "fr": "1,2 m/s"
          }
        }
      ]
    },
    {
      "key": "line_spacing",
      "type": "number",
      "label": {
        "en": "Path spacing (cm)",
        "fr": "Espacement des trajectoires (cm)"
      },
      "description": {
        "en": "Kept within the range of each mower model (e.g. 20 to 32 cm on a Luba 2).",
        "fr": "Ramené dans la plage de chaque modèle de tondeuse (par ex. 20 à 32 cm sur une Luba 2)."
      },
      "required": false,
      "default": 32,
      "min": 15,
      "max": 40
    },
    {
      "key": "angle_mode",
      "type": "select",
      "label": {
        "en": "Path angle",
        "fr": "Angle de coupe de la trajectoire"
      },
      "description": {
        "en": "Optimal: the mower chooses. Custom: the angle below. Random: a new angle for each job.",
        "fr": "Optimal : la tondeuse choisit. Personnaliser : l'angle ci-dessous. Aléatoire : un nouvel angle à chaque tonte."
      },
      "required": false,
      "default": "optimal",
      "options": [
        {
          "value": "optimal",
          "label": {
            "en": "Optimal",
            "fr": "Optimal"
          }
        },
        {
          "value": "custom",
          "label": {
            "en": "Custom",
            "fr": "Personnaliser"
          }
        },
        {
          "value": "random",
          "label": {
            "en": "Random",
            "fr": "Aléatoire"
          }
        }
      ]
    },
    {
      "key": "mowing_angle",
      "type": "number",
      "label": {
        "en": "Custom path angle (°)",
        "fr": "Angle personnalisé (°)"
      },
      "description": {
        "en": "Used when the path angle is \"Custom\".",
        "fr": "Utilisé quand l'angle de coupe est « Personnaliser »."
      },
      "required": false,
      "default": 111,
      "min": 0,
      "max": 180
    },
    {
      "key": "mowing_pattern",
      "type": "select",
      "label": {
        "en": "Mowing pattern",
        "fr": "Mode trajectoire de tonte"
      },
      "required": false,
      "default": "zigzag",
      "options": [
        {
          "value": "zigzag",
          "label": {
            "en": "Zigzag",
            "fr": "Trajectoire en zigzag"
          }
        },
        {
          "value": "chessboard",
          "label": {
            "en": "Chessboard",
            "fr": "Damier"
          }
        },
        {
          "value": "zigzag_adaptive",
          "label": {
            "en": "Adaptive zigzag",
            "fr": "Zigzag adaptatif"
          }
        }
      ]
    },
    {
      "key": "border_laps",
      "type": "number",
      "label": {
        "en": "Perimeter laps",
        "fr": "Tours de tonte du périmètre"
      },
      "required": false,
      "default": 0,
      "min": 0,
      "max": 4
    },
    {
      "key": "obstacle_detection",
      "type": "select",
      "label": {
        "en": "Obstacle detection",
        "fr": "Mode détection d'obstacle"
      },
      "required": false,
      "default": "off",
      "options": [
        {
          "value": "off",
          "label": {
            "en": "Off",
            "fr": "Désactivé"
          }
        },
        {
          "value": "slow",
          "label": {
            "en": "Slow down on contact",
            "fr": "Ralentir au contact"
          }
        },
        {
          "value": "less",
          "label": {
            "en": "Avoid contact",
            "fr": "Éviter le contact"
          }
        }
      ]
    },
    {
      "key": "obstacle_laps",
      "type": "number",
      "label": {
        "en": "No-go zone laps",
        "fr": "Tours de tonte des zones interdites"
      },
      "required": false,
      "default": 0,
      "min": 0,
      "max": 3
    },
    {
      "key": "mowing_order",
      "type": "select",
      "label": {
        "en": "Path order",
        "fr": "Ordre des itinéraires"
      },
      "required": false,
      "default": "zigzag_first",
      "options": [
        {
          "value": "zigzag_first",
          "label": {
            "en": "Zigzag first",
            "fr": "Zigzag d'abord"
          }
        },
        {
          "value": "border_first",
          "label": {
            "en": "Perimeter first",
            "fr": "Périmètre d'abord"
          }
        }
      ]
    },
    {
      "key": "start_progress",
      "type": "number",
      "label": {
        "en": "Start progress (%)",
        "fr": "Progression du démarrage (%)"
      },
      "description": {
        "en": "Start the job at this share of the zone: 0 starts from the beginning.",
        "fr": "Commencer la tonte à ce pourcentage de la zone : 0 part du début."
      },
      "required": false,
      "default": 0,
      "min": 0,
      "max": 99
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion"
      },
      "timeout_seconds": 60
    },
    {
      "key": "refresh",
      "label": {
        "en": "Refresh the mowers now",
        "fr": "Rafraîchir les tondeuses"
      },
      "timeout_seconds": 60
    }
  ]
}
